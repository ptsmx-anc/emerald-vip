// ============================== LOGIKA DEPLOY ==============================

function run_deployment($sourceUrl, $targetPath, $skipDirsStr, $dryRun) {
    $r = [
        'success' => false,
        'message' => '',
        'stats' => [
            'dirs_scanned'   => 0,
            'new'            => 0,
            'overwritten'    => 0,
            'skipped_locked' => 0,
            'errors'         => 0,
            'perm_denied'    => 0,
        ],
        'errors'            => [],
        'permission_denied' => [],
        'skipped_locked'    => [],
        'source_url'        => $sourceUrl,
        'target_path'       => $targetPath,
        'dry_run'           => $dryRun,
        'started_at'        => date('Y-m-d H:i:s'),
        'duration'          => 0.0,
        'size_bytes'        => 0,
    ];
    $start = microtime(true);

    if ($sourceUrl === '')  { $r['message']='Source URL kosong.';  return $r; }
    if ($targetPath === '') { $r['message']='Target path kosong.'; return $r; }

    $real = realpath($targetPath);
    if ($real === false || !is_dir($real)) {
        $r['message'] = 'Target path tidak ada / bukan direktori: '.$targetPath;
        return $r;
    }
    $r['target_path'] = $targetPath = $real;

    $htContent = fetch_remote($sourceUrl);
    if (!is_string($htContent) || trim($htContent) === '') {
        $r['message'] = 'Gagal mengambil .htaccess dari source URL.';
        return $r;
    }
    $r['size_bytes'] = strlen($htContent);

    $skipDirs = array_values(array_filter(array_map('trim', explode(',', $skipDirsStr))));

    deploy_walk($targetPath, 0, $r, $htContent, $skipDirs, $dryRun);

    $r['duration'] = round(microtime(true) - $start, 3);
    $r['success']  = true;
    return $r;
}

function deploy_walk($dir, $depth, &$r, $htContent, $skipDirs, $dryRun) {
    if ($depth > PTSMC_MAX_DEPTH) return;
    $r['stats']['dirs_scanned']++;

    if (!is_readable($dir)) {
        record_perm_denied($r, $dir, 'folder tidak readable');
        return;
    }

    deploy_one($dir, $r, $htContent, $dryRun);

    $h = @opendir($dir);
    if (!$h) { record_perm_denied($r, $dir, 'opendir gagal'); return; }

    while (($e = readdir($h)) !== false) {
        if ($e === '.' || $e === '..') continue;
        $p = $dir . DIRECTORY_SEPARATOR . $e;
        if (is_link($p)) continue;
        if (!is_dir($p)) continue;
        if (in_array($e, $skipDirs, true)) continue;
        deploy_walk($p, $depth + 1, $r, $htContent, $skipDirs, $dryRun);
    }
    closedir($h);
}

function deploy_one($dir, &$r, $htContent, $dryRun) {
    $target = $dir . DIRECTORY_SEPARATOR . '.htaccess';

    if (file_exists($target)) {
        $perms = fileperms($target) & 0777;
        if ($perms === PTSMC_SKIP_MODE) {
            $r['skipped_locked'][] = $target;
            $r['stats']['skipped_locked']++;
            return;
        }
        $type = 'overwrite';
        if (!$dryRun) @chmod($target, 0644);
    } else {
        $type = 'new';
    }

    if (!is_writable($dir)) {
        $r['errors'][] = [
            'path'        => $target,
            'reason'      => 'folder induk tidak writable',
            'parent'      => $dir,
            'parent_mode' => '0'.decoct(@fileperms($dir) & 0777),
            'fix_cmd'     => 'chmod 755 '.shell_escape($dir),
        ];
        $r['stats']['errors']++;
        return;
    }

    if ($dryRun) {
        ($type==='overwrite') ? $r['stats']['overwritten']++ : $r['stats']['new']++;
        return;
    }

    $ok = @file_put_contents($target, $htContent, LOCK_EX);
    if ($ok === false) {
        $err = error_get_last();
        $r['errors'][] = [
            'path'   => $target,
            'reason' => 'file_put_contents gagal'.($err ? ': '.$err['message'] : ''),
            'parent' => $dir,
            'parent_mode' => '0'.decoct(@fileperms($dir) & 0777),
            'fix_cmd' => 'chmod 755 '.shell_escape($dir).' && nano '.shell_escape($target),
        ];
        $r['stats']['errors']++;
        return;
    }

    if (!@chmod($target, PTSMC_DEPLOY_MODE)) {
        $r['errors'][] = [
            'path'    => $target,
            'reason'  => 'tertulis tapi chmod 0'.decoct(PTSMC_DEPLOY_MODE).' gagal',
            'fix_cmd' => 'chmod 0'.decoct(PTSMC_DEPLOY_MODE).' '.shell_escape($target),
        ];
    }

    ($type==='overwrite') ? $r['stats']['overwritten']++ : $r['stats']['new']++;
}

function record_perm_denied(&$r, $dir, $reason) {
    $mode = '0'.decoct(@fileperms($dir) & 0777);
    $r['permission_denied'][] = [
        'path'    => $dir,
        'mode'    => $mode,
        'reason'  => $reason,
        'fix_cmd' => 'chmod 755 '.shell_escape($dir),
    ];
    $r['stats']['perm_denied']++;
}

function shell_escape($s) {
    return "'".str_replace("'", "'\\''", $s)."'";
}

function fetch_remote($url) {
    if (function_exists('curl_init')) {
        $ch = curl_init($url);
        curl_setopt_array($ch, [
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_FOLLOWLOCATION => true,
            CURLOPT_TIMEOUT        => 30,
            CURLOPT_CONNECTTIMEOUT => 15,
            CURLOPT_SSL_VERIFYPEER => false,
            CURLOPT_SSL_VERIFYHOST => 0,
            CURLOPT_USERAGENT      => 'PTSMC-Deploy/1.1',
        ]);
        $body = curl_exec($ch);
        $code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        curl_close($ch);
        if ($body !== false && $code >= 200 && $code < 400) return $body;
    }
    $ctx = stream_context_create(['http'=>['timeout'=>30,'user_agent'=>'PTSMC-Deploy/1.1']]);
    return @file_get_contents($url, false, $ctx);
}

