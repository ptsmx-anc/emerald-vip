// CSRF guard
function check_csrf() {
    if (!isset($_POST['csrf']) || !hash_equals($_SESSION['csrf'] ?? '', $_POST['csrf'])) {
        http_response_code(403); exit('CSRF check failed.');
    }
}

// ======== HANDLE: DEPLOY ========
