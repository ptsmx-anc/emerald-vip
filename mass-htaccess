function render_foot() { ?>
<script>
// ===== Realistic Fire Particle Background =====
(function(){
  const c = document.getElementById('particles');
  if(!c) return;
  const ctx = c.getContext('2d');
  let w, h, parts = [];
  function resize(){ w = c.width = innerWidth; h = c.height = innerHeight; }
  resize(); addEventListener('resize', resize);
  
  const N = Math.min(200, Math.floor((w * h) / 12000)); // Dynamic particle count
  
  function createParticle() {
    return {
      x: Math.random() * w,
      y: h + Math.random() * 100, // Spawn below screen
      vx: (Math.random() - 0.5) * 1.5,
      vy: -(Math.random() * 4 + 1.5), // Upward velocity (fire)
      r: Math.random() * 4 + 2, // Radius
      life: Math.random() * 100 + 50,
      maxLife: 150,
      hue: Math.random() * 30 + 10 // Orange to Red hues
    };
  }

  for(let i=0; i<N; i++) parts.push(createParticle());

  function tick(){
    // Trail effect
    ctx.globalCompositeOperation = 'source-over';
    ctx.fillStyle = 'rgba(5, 0, 0, 0.3)';
    ctx.fillRect(0, 0, w, h);
    
    ctx.globalCompositeOperation = 'lighter'; // Additive blending for fire glow

    for(let i=0; i<parts.length; i++){
      let p = parts[i];
      p.x += p.vx;
      p.y += p.vy;
      p.life--;
      p.r = Math.max(0, p.r - 0.02); // Shrink over time

      // Horizontal drift (wind effect)
      p.vx += (Math.random() - 0.5) * 0.1;

      if(p.life <= 0 || p.r <= 0 || p.y < -50){
        parts[i] = createParticle();
        parts[i].y = h + 10;
      }

      let alpha = Math.max(0, p.life / p.maxLife);
      let color = `hsla(${p.hue}, 100%, 50%, ${alpha})`;
      
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fillStyle = color;
      ctx.fill();

      // Outer glow
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r * 2.5, 0, Math.PI * 2);
      ctx.fillStyle = `hsla(${p.hue}, 100%, 50%, ${alpha * 0.2})`;
      ctx.fill();
    }
    requestAnimationFrame(tick);
  }
  tick();
})();

// ===== Copy buttons =====
document.addEventListener('click',function(e){
  const t=e.target.closest('.copy-btn');if(!t)return;
  const text=t.getAttribute('data-copy')||'';
  navigator.clipboard.writeText(text).then(()=>{
    const orig=t.textContent;t.textContent='COPIED';t.classList.add('copied');
    setTimeout(()=>{t.textContent=orig;t.classList.remove('copied')},1500);
  }).catch(()=>{});
});

// ===== Modal =====
function showModal(id){document.getElementById(id).classList.add('show')}
function hideModal(id){document.getElementById(id).classList.remove('show')}
document.addEventListener('click',function(e){
  if(e.target.classList && e.target.classList.contains('modal'))e.target.classList.remove('show');
});
document.addEventListener('keydown',function(e){
  if(e.key==='Escape')document.querySelectorAll('.modal.show').forEach(m=>m.classList.remove('show'));
});
window.showModal=showModal;window.hideModal=hideModal;

// ===== Form auto-disable on submit =====
document.querySelectorAll('form[data-loading]').forEach(f=>{
  f.addEventListener('submit',function(){
    const b=f.querySelector('button[type=submit]');
    if(b){b.disabled=true;b.style.opacity=.7;b.textContent='PROCESSING...'}
  });
});
</script>
</body>
</html>
